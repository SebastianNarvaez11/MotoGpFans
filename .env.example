# ─────────────────────────────────────────────────────────────────────────────
# MotoGP Fans — variables de entorno
#
# Copia este archivo a `.env` y rellena los valores.
# `.env` está ignorado por git: NUNCA subas secretos al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos (Neon Postgres) ────────────────────────────────────────────
# Créala desde Vercel → Storage → Neon, o en console.neon.tech
#
# DATABASE_URL: cadena CON pooler (termina en `-pooler`). La usa la aplicación.
# DIRECT_URL:   cadena SIN pooler. La usa Prisma Migrate (las migraciones no
#               funcionan a través de un pooler en modo transacción).
DATABASE_URL="postgresql://usuario:contrasena@ep-xxx-pooler.region.aws.neon.tech/motogpfans?sslmode=require"
DIRECT_URL="postgresql://usuario:contrasena@ep-xxx.region.aws.neon.tech/motogpfans?sslmode=require"

# ── Ingesta de datos ─────────────────────────────────────────────────────────
# Secreto que autoriza POST /api/ingest (lo envía el cron de GitHub Actions
# en la cabecera Authorization: Bearer ...). Mínimo 32 caracteres.
# Genera uno con:  openssl rand -base64 32
INGEST_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# ── Sitio ────────────────────────────────────────────────────────────────────
# URL pública, sin barra final. Se usa en metadata absoluta (Open Graph,
# sitemap.xml, hreflang).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
